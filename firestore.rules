rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/products/{productId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['name','category','price','image','createdAt','updatedAt'])
          && d.keys().hasOnly(['name','category','price','image','createdAt','updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.category is string && d.category.size() > 0 && d.category.size() <= 60
          && d.price is int && d.price > 0 && d.price <= 1000000000
          && d.image is string && d.image.size() <= 350000
          && (d.image.matches('data:image/jpeg;base64,.*')
            || (d.image.size() <= 2048 && d.image.matches('https://[^/]+.*')))
          && d.updatedAt == request.time;
      }
      allow read, delete: if owner();
      allow create: if owner() && valid() && request.resource.data.createdAt == request.time;
      allow update: if owner() && valid() && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
